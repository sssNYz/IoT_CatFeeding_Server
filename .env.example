# Copy to .env and change every value. Never commit .env.

# PostgreSQL (the app builds DATABASE_URL from these inside Docker)
POSTGRES_USER=catfeeder
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=catfeeder

# JWT signing secret (HS256). Make one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Mosquitto login for the app (user "backend" in the ACL). Make one with: openssl rand -base64 24
MQTT_BACKEND_PASSWORD=change-me-mqtt

# MinIO (images and sounds)
MINIO_ROOT_USER=catfeeder
MINIO_ROOT_PASSWORD=change-me-minio

# Seed accounts, created on first start (spec Section 7). No sign-up, no email.
SEED_ADMIN_EMAIL=admin@catfeeder.test
SEED_ADMIN_PASSWORD=change-me-admin
SEED_OWNER_EMAIL=owner@catfeeder.test
SEED_OWNER_PASSWORD=change-me-owner

# Tests only: where the running server is
API_BASE_URL=http://localhost:3000/api/v1
MQTT_TEST_URL=mqtt://localhost:1883

    {
      "name": "Feeder status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const s = pm.response.json();",
              "pm.test(\"state is online, offline or unknown\", () => pm.expect([\"online\", \"offline\", \"unknown\"]).to.include(s.state));",
              "pm.test(\"synced means the versions match\", () => pm.expect(s.synced).to.eql(s.applied_schedule_version === s.schedule_version));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/feeders/feeder01/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "feeders",
            "feeder01",
            "status"
          ]
        }
      }
    },
    {
      "name": "Schedules",
      "item": [
        {
          "name": "List schedules",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test(\"Thai time zone\", () => pm.expect(res.timezone).to.eql(\"Asia/Bangkok\"));",
                  "pm.collectionVariables.set(\"scheduleVersion\", res.schedule_version);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/feeders/feeder01/schedules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "feeders",
                "feeder01",
                "schedules"
              ]
            }
          }
        },
        {
          "name": "Add a schedule",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.test(\"version went up by 1\", () => pm.expect(res.schedule_version).to.eql(Number(pm.collectionVariables.get(\"scheduleVersion\")) + 1));",
                  "pm.collectionVariables.set(\"scheduleId\", res.schedule.schedule_id);",
                  "pm.collectionVariables.set(\"scheduleVersion\", res.schedule_version);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/feeders/feeder01/schedules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "feeders",
                "feeder01",
                "schedules"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"time\": \"12:30\",\n  \"portion_g\": 25,\n  \"enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Edit the schedule",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.test(\"saved the new time\", () => pm.expect(res.schedule.time).to.eql(\"13:00\"));",
                  "pm.test(\"version went up by 1\", () => pm.expect(res.schedule_version).to.eql(Number(pm.collectionVariables.get(\"scheduleVersion\")) + 1));",
                  "pm.collectionVariables.set(\"scheduleVersion\", res.schedule_version);"

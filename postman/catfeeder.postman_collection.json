                "cats"
              ]
            }
          }
        },
        {
          "name": "Add a cat",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh tag each run, since tags are unique and cats cannot be deleted.",
                  "pm.collectionVariables.set(\"rfidTag\", Math.floor(Math.random() * 0xffffffff).toString(16).toUpperCase().padStart(8, \"0\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"saved the tag\", () => pm.expect(pm.response.json().rfid_tag).to.eql(pm.collectionVariables.get(\"rfidTag\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cats"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kuro\",\n  \"rfid_tag\": \"{{rfidTag}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Feeding history",
      "item": [
        {
          "name": "History (newest first)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const { events } = pm.response.json();",
                  "pm.test(\"newest occurred_at first\", () => events.forEach((e, i) => i && pm.expect(Date.parse(events[i - 1].occurred_at)).to.be.at.least(Date.parse(e.occurred_at))));",
                  "pm.test(\"Thai time\", () => events.forEach((e) => pm.expect(e.occurred_at).to.match(/\\+07:00$/)));",
                  "// Remember the newest received_at for the poll below.",
                  "pm.collectionVariables.set(\"since\", events.map((e) => e.received_at).sort().pop());",
                  "// Query strings read + as a space, so send +07:00 as %2B07:00.",
                  "pm.collectionVariables.set(\"sinceEncoded\", encodeURIComponent(pm.collectionVariables.get(\"since\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/feeders/feeder01/events?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "feeders",
                "feeder01",
                "events"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Poll for new events (since)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"only events received after since\", () => pm.response.json().events.forEach((e) => pm.expect(Date.parse(e.received_at)).to.be.above(Date.parse(pm.collectionVariables.get(\"since\")))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/feeders/feeder01/events?since={{sinceEncoded}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "feeders",
                "feeder01",
                "events"
              ],
              "query": [
                {
                  "key": "since",
                  "value": "{{sinceEncoded}}"
                }
              ]
            }
          }
        }
      ]
    },

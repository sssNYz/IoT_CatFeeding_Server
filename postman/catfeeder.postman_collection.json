{
  "info": {
    "name": "Cat Feeder API",
    "description": "Run \"Log in (owner)\" first: it saves the token for every other request. Set baseUrl, email and password in the collection Variables tab (adminEmail and adminPassword for the Admin folder).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://82.26.104.235:3000/api/v1"
    },
    {
      "key": "email",
      "value": "owner@catfeeder.test"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "scheduleId",
      "value": ""
    },
    {
      "key": "scheduleVersion",
      "value": ""
    },
    {
      "key": "rfidTag",
      "value": ""
    },
    {
      "key": "since",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "admin@catfeeder.test"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "sinceEncoded",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Log in (owner)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"token\", pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },

              "raw": "{{baseUrl}}/feeders/feeder01/schedules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "feeders",
                "feeder01",
                "schedules"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schedule_id\": \"{{scheduleId}}\",\n  \"time\": \"13:00\",\n  \"portion_g\": 30,\n  \"enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }

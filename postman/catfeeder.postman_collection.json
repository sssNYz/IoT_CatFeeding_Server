                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"has the seeded cats\", () => pm.expect(pm.response.json().cats.map((c) => c.rfid_tag)).to.include.members([\"E200001A\", \"E200001B\"]));"
                ]
